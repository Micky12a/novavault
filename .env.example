# Copie ce fichier en .env puis remplis les valeurs (voir README)

# Base de données Neon (Dashboard Neon > Connect)
DATABASE_URL="postgresql://...-pooler...neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://...neon.tech/neondb?sslmode=require"

# Photos : Vercel > Storage > Blob > ton store > .env.local
BLOB_READ_WRITE_TOKEN=""

# Premier compte admin, créé par `npm run db:seed`
ADMIN_EMAIL="toi@exemple.com"
ADMIN_PASSWORD="un-mot-de-passe-long-et-unique"

# Pixels (chargés uniquement après consentement cookies)
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""

# Recette : "true" affiche les 12 landings quelle que soit la date
NEXT_PUBLIC_SHOW_ALL_EVENTS="true"
